# ===== Google Cloud (optional in offline mode) =====
GCP_PROJECT_ID=
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-005

# ===== Elastic =====
# Leave ELASTIC_CLOUD_ID blank to use the local Elasticsearch
# container defined in docker-compose.yml. Set both to point at
# Elastic Cloud instead.
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_URL=http://elasticsearch:9200
ELASTIC_PAPERS_INDEX=papers
ELASTIC_CLAIMS_INDEX=claims

# ===== Firestore (offline fallback: local JSON file) =====
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_JOBS=jobs
FIRESTORE_COLLECTION_RECONSTRUCTIONS=reconstructions

# ===== Cloud Storage (offline fallback: local directory) =====
GCS_BUCKET_UPLOADS=methods-reconstructor-uploads
GCS_BUCKET_EXPORTS=methods-reconstructor-exports

# ===== Redis (optional) =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== External paper APIs =====
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=
GROBID_URL=http://grobid:8070

# ===== LLM provider selection =====
# Order: gemini > anthropic > offline (deterministic mock)
# Provide ONE of these to use real LLM calls.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto                # auto | gemini | anthropic | offline

# ===== App =====
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000
APP_MAX_RECURSION_DEPTH=5
APP_PER_PAPER_TOKEN_BUDGET=500000
APP_AGENT_TIMEOUT_SECONDS=300
APP_MAX_CONCURRENT_JOBS=2
APP_MAX_CONCURRENT_CLAIMS=4
APP_MAX_METHODS_CHUNK_CHARS=40000
APP_MAX_ASSEMBLY_CHARS=100000

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SSE_URL=http://localhost:8000
