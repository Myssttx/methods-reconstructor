# Copy this file to .env. Never commit .env or real credentials.

# Google Cloud / Vertex AI / Google ADK
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_LOCATION=us-central1
ADK_MODEL=gemini-3.0-flash
GEMINI_MODEL_PRO=gemini-3.0-pro
GEMINI_MODEL_FLASH=gemini-3.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-005
ENABLE_VERTEX_EMBEDDINGS=0

# Elastic Cloud. Leave cloud credentials blank for local Elasticsearch.
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
ELASTIC_URL=http://elasticsearch:9200
ELASTIC_PAPERS_INDEX=papers
ELASTIC_CLAIMS_INDEX=claims
# Optional Elastic Agent Builder MCP streamable HTTP endpoint.
ELASTIC_MCP_URL=
ELASTIC_MCP_AUTH_TOKEN=

# Optional persistence
ENABLE_FIRESTORE=0
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_JOBS=jobs
FIRESTORE_COLLECTION_RECONSTRUCTIONS=reconstructions
GCS_BUCKET_UPLOADS=your-project-methods-uploads
GCS_BUCKET_EXPORTS=your-project-methods-exports

# Local services
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
GROBID_URL=http://grobid:8070

# Public paper metadata services
OPENALEX_EMAIL=researcher@example.com
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=researcher@example.com
NCBI_EMAIL=researcher@example.com
NCBI_API_KEY=

# Model provider. Vertex AI uses ADC and does not require GOOGLE_API_KEY.
LLM_PROVIDER=auto
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=8192

# Agent limits
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000
APP_MAX_RECURSION_DEPTH=5
APP_PER_PAPER_TOKEN_BUDGET=500000
APP_AGENT_TIMEOUT_SECONDS=600
APP_MAX_CONCURRENT_JOBS=2
APP_MAX_QUEUE_DEPTH=50
APP_MAX_CONCURRENT_CLAIMS=4
APP_MAX_CONCURRENT_LLM_CHUNKS=3
APP_MAX_METHODS_CHUNK_CHARS=3000
APP_LLM_CHUNK_TIMEOUT_SECONDS=15
APP_EXTRACTION_WALL_BUDGET_SECONDS=35
APP_METHODS_EXTRACTION_MODE=hybrid
APP_LARGE_METHODS_SENTENCE_THRESHOLD=40
APP_MAX_ASSEMBLY_CHARS=100000
APP_USE_LLM_ASSEMBLY=0
APP_REUSE_CACHED_CLAIMS=1
APP_NEGATIVE_ACQUISITION_CACHE_SECONDS=3600

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SSE_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# API authentication. Leave blank only for local development.
API_KEY=
